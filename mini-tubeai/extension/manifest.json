{
  "manifest_version": 3,
  "name": "mini TubeAI",
  "version": "0.2.0",
  "description": "Ask questions about the YouTube video you're watching, answered by your local mini TubeAI server.",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "mini TubeAI",
    "default_popup": "popup.html"
  }
}
